# Port the API Gateway itself listens on
PORT=8080

# Address of the auth gRPC service (needed to validate tokens at the gateway)
AUTH_GRPC_ADDR=localhost:50051
# For Docker, replace with: AUTH_GRPC_ADDR=auth-service:50051

# HTTP upstreams for proxying requests from the gateway to the microservices
# For Docker: AUTH_HTTP_ADDR=http://auth-service:8081
AUTH_HTTP_ADDR=http://localhost:8081

# For Docker: AGENTS_HTTP_ADDR=http://agents-service:8082
AGENTS_HTTP_ADDR=http://localhost:8082

# For Docker: CHATS_HTTP_ADDR=http://chats-service:8083
CHATS_HTTP_ADDR=http://localhost:8083

# For Docker: NEWS_HTTP_ADDR=http://news:5000
NEWS_HTTP_ADDR=http://localhost:5000


# Allowed origins for CORS (comma-separated, no spaces)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Redis cache configuration (for future sessions / rate limiter)
REDIS_ADDR=localhost:6379
# For Docker: REDIS_ADDR=redis:6379
