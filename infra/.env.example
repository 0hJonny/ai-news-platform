# Copy to infra/.env and fill in real values before `docker compose up`.

# --- Postgres: single instance, schemas auth/chats/news/profiles ---
POSTGRES_USER=platform_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=platform_db

# --- MinIO (file storage for backend/news) ---
MINIO_USER=minio_admin
MINIO_PASSWORD=change-me

# --- PgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=change-me

# --- backend/core: auth ---
JWT_SECRET=change-me

# --- backend/core: gateway CORS (origins the browser actually requests from) ---
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173

# --- backend/news: admin user that parser/annotation authenticate as ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- workers/agent (LangGraph) ---
LLM_PROVIDER=lmstudio
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=gemma2:9b
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
LMSTUDIO_MODEL=google/gemma-4-e4b
LLM_TEMPERATURE=0.0
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_COLLECTION=local_it_news
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
